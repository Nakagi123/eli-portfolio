---
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const rarityLabels = {
  common: 'COMMON',
  rare: 'RARE',
  epic: 'EPIC',
  legendary: 'LEGENDARY',
};

const rarityStyles = {
  common: 'text-foreground/70',
  rare: 'text-sky-300',
  epic: 'text-accent',
  legendary: 'text-amber-300',
};
---

<div
  id="project-inventory"
  data-project-inventory
  class="inventory-panel relative w-full max-w-[650px]"
  aria-label="Featured project inventory"
  inert
>
  <!-- Magical frame -->
  <div class="border-2 border-accent bg-surface p-3 shadow-[0_0_35px_rgba(181,162,208,0.16)] sm:p-5">
    <div class="mb-4 flex items-center justify-between gap-3 border-b border-outline pb-3">
      <div>
        <p class="font-pixel text-[9px] text-accent">
          ✦ INVENTORY UNLOCKED
        </p>

        <h3 class="mt-2 font-pixel text-xs text-foreground sm:text-sm">
          PROJECT ARTIFACTS
        </h3>
      </div>

      <span class="font-ui text-[10px] text-foreground/60">
        {projects.length} ITEMS
      </span>
    </div>

    {projects.length > 0 ? (
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {projects.map((project) => (
          <div class="inventory-item group relative min-w-0">
            <a
              href={`/projects/${project.slug}`}
              class="inventory-slot flex min-h-[116px] flex-col items-center justify-center gap-2 border border-outline bg-background p-3 text-center transition-colors hover:border-accent hover:bg-accent/10 focus-visible:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              aria-label={`View project: ${project.title}`}
            >
              <span class="text-3xl" aria-hidden="true">
                {project.icon}
              </span>

              <span class="font-ui text-xs font-semibold text-foreground">
                {project.title}
              </span>

              <span class={`font-pixel text-[8px] ${rarityStyles[project.rarity]}`}>
                {rarityLabels[project.rarity]}
              </span>
            </a>

            <!-- Desktop tooltip -->
            <div
              class="inventory-tooltip pointer-events-none absolute bottom-[calc(100%+10px)] left-1/2 z-30 hidden w-[240px] -translate-x-1/2 border border-accent bg-background p-3 shadow-xl group-hover:block group-focus-within:block sm:block sm:opacity-0 sm:transition-opacity sm:group-hover:opacity-100 sm:group-focus-within:opacity-100"
              aria-hidden="true"
            >
              <p class="font-pixel text-[9px] text-accent">
                {project.category}
              </p>

              <p class="mt-2 font-ui text-sm font-semibold text-foreground">
                {project.title}
              </p>

              <p class="mt-2 font-ui text-xs leading-relaxed text-foreground/80">
                {project.summary}
              </p>

              <p class="mt-3 font-ui text-[10px] text-accent">
                {project.technologies.join(' · ')}
              </p>
            </div>

            <!-- Mobile: visible summary under slot -->
            <p class="mt-2 line-clamp-2 font-ui text-[10px] leading-relaxed text-foreground/65 sm:hidden">
              {project.summary}
            </p>
          </div>
        ))}
      </div>
    ) : (
      <p class="py-8 text-center font-ui text-xs text-foreground/70">
        No artifacts discovered yet.
      </p>
    )}

    <div class="mt-5 border-t border-outline pt-4 text-center">
      <a
        href="/projects"
        class="pixel-button inline-flex items-center justify-center gap-2"
      >
        VIEW ALL ARTIFACTS ↗
      </a>
    </div>
  </div>
</div>

<style>
  .inventory-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(28px) scale(0.96);
    transition:
      opacity 420ms ease,
      transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 420ms;
  }

  .inventory-panel.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .inventory-panel {
      transition: none;
    }
  }
</style>