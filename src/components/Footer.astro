---
const exploreLinks = [
  { label: 'The Toolkit', href: '/#skills' },
  { label: 'The Work Archive', href: '/#projects' },
  { label: 'The Achievements', href: '/#certifications' },
  { label: 'The Journey', href: '/#experience' },
];

const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/Nakagi123',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/elian-malik-achmad-uluelang/',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/nakagi_123/',
  },
  {
    label: 'Email',
    href: 'mailto:elianmalik2610@gmail.com',
  },
];
---

<footer
  class="border-t border-outline bg-background"
  aria-label="Site footer"
>
  <!-- Full-width container with comfortable edge padding -->
  <div class="w-full px-6 py-8 sm:px-10 sm:py-10 lg:px-16 xl:px-20">
    <!-- Top label -->
    <div
      class="mb-5 flex flex-wrap items-center
             justify-between gap-3"
    >
      <p
        class="font-pixel text-[9px]
               tracking-wider text-accent"
      >
        ✦ END OF THE ADVENTURE
      </p>

      <a
        href="/"
        class="font-pixel text-xs text-foreground
               transition-colors hover:text-accent"
        aria-label="ELI.EXE — Back to homepage"
      >
        ELI.EXE
      </a>
    </div>

    <!-- Four columns spread across the footer -->
    <div
      class="grid grid-cols-1 gap-6
             border-t border-outline pt-6
             sm:grid-cols-2
             lg:grid-cols-4 lg:gap-10"
    >
      <!-- Developer -->
      <div class="space-y-2">
        <h2
          class="font-pixel text-[9px]
                 tracking-wider text-accent"
        >
          THE DEVELOPER
        </h2>

        <div
          class="space-y-1 font-ui text-xs
                 leading-relaxed text-foreground/80"
        >
          <p class="font-semibold text-foreground">
            Elian Malik
          </p>

          <p>Developer & lifelong learner.</p>

          <p>Based in Indonesia.</p>
        </div>
      </div>

      <!-- Explore -->
      <nav aria-label="Footer navigation" class="space-y-2">
        <h2
          class="font-pixel text-[9px]
                 tracking-wider text-accent"
        >
          EXPLORE
        </h2>

        <ul class="space-y-1.5">
          {exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-ui text-xs text-foreground/80
                       transition-colors hover:text-accent
                       focus-visible:outline-2
                       focus-visible:outline-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Connect -->
      <nav aria-label="Social links" class="space-y-2">
        <h2
          class="font-pixel text-[9px]
                 tracking-wider text-accent"
        >
          CONNECT
        </h2>

        <ul class="space-y-1.5">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={
                  link.href.startsWith('mailto:')
                    ? undefined
                    : '_blank'
                }
                rel={
                  link.href.startsWith('mailto:')
                    ? undefined
                    : 'noopener noreferrer'
                }
                class="group inline-flex items-center
                       gap-1.5 font-ui text-xs
                       text-foreground/80
                       transition-colors hover:text-accent
                       focus-visible:outline-2
                       focus-visible:outline-accent"
              >
                {link.label}

                <span
                  class="text-accent transition-transform
                         group-hover:-translate-y-0.5
                         group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Personal note -->
      <div class="space-y-2">
        <h2
          class="font-pixel text-[9px]
                 tracking-wider text-accent"
        >
          A LITTLE NOTE
        </h2>

        <p
          class="max-w-xs font-ui text-xs
                 leading-relaxed text-foreground/80"
        >
          Built with curiosity, countless experiments,
          and probably too much debugging.
        </p>

        <p
          class="font-pixel text-[8px]
                 leading-relaxed text-accent"
        >
          QUESTS ARE NEVER TRULY OVER ✦
        </p>
      </div>
    </div>
  </div>
</footer>