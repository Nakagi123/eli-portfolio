---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="sticky top-0 z-50 border-b border-outline bg-background">
  <nav
    class="section-container flex min-h-20 flex-wrap items-center justify-between gap-4 py-3"
    aria-label="Main navigation"
  >
    <a href="/" class="font-pixel text-lg tracking-tight text-accent">
      ELI.EXE
    </a>

    <div class="flex flex-wrap items-center gap-4 sm:gap-7">
      <div class="flex items-center gap-4 sm:gap-6">
        {links.map((link) => (
          <a
            href={link.href}
            class="font-ui group flex items-center gap-1 text-xs text-muted transition-colors hover:text-accent"
          >
            <span
              aria-hidden="true"
              class="text-accent opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
            >
              ▶
            </span>
            {link.label}
          </a>
        ))}
      </div>

      <ThemeToggle />
    </div>
  </nav>
</header>