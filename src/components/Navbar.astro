---
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';

const links = [
  { label: 'Skills', href: '/#skills' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Certifications', href: '/#certifications' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="sticky top-0 z-50 border-b border-outline bg-background">
  <nav
    class="section-container flex min-h-20 flex-wrap items-center justify-between gap-3 py-3"
    aria-label="Main navigation"
  >
    <!-- Website logo -->
    <a
      href="/"
      class="font-pixel text-lg text-accent"
    >
      ELI.EXE
    </a>

    <!-- Desktop navigation -->
    <div class="hidden items-center gap-5 lg:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="font-ui group flex items-center gap-1 text-xs text-muted transition-colors hover:text-accent"
        >
          <span
            aria-hidden="true"
            class="text-accent opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100"
          >
            ▶
          </span>

          {link.label}
        </a>
      ))}
    </div>

    <!-- Theme, sound, and mobile menu controls -->
    <div class="flex items-center gap-3">
      <!-- Enable / disable sound effects -->
      <SoundToggle />

      <!-- Midnight / Daybreak theme toggle -->
      <ThemeToggle />

      <!-- Mobile navigation button -->
      <button
        id="menu-toggle"
        type="button"
        class="font-ui flex min-h-11 min-w-11 items-center justify-center border border-outline text-lg lg:hidden"
        aria-label="Open navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span
          id="menu-icon"
          aria-hidden="true"
        >
          ☰
        </span>
      </button>
    </div>

    <!-- Mobile navigation -->
    <div
      id="mobile-menu"
      class="hidden w-full border-t border-outline pt-4 lg:hidden"
      hidden
    >
      <div class="flex flex-col gap-1 pb-3">
        {links.map((link) => (
          <a
            href={link.href}
            class="font-ui mobile-nav-link flex min-h-11 items-center gap-3 px-2 text-sm text-muted hover:bg-surface hover:text-accent"
          >
            <span
              aria-hidden="true"
              class="text-accent"
            >
              ▶
            </span>

            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  function setupMobileMenu() {
    const button = document.querySelector<HTMLButtonElement>(
      '#menu-toggle'
    );

    const menu = document.querySelector<HTMLElement>(
      '#mobile-menu'
    );

    const icon = document.querySelector<HTMLElement>(
      '#menu-icon'
    );

    if (!button || !menu || !icon) {
      return;
    }

    if (button.dataset.initialized === 'true') {
      return;
    }

    // Stable references for TypeScript inside callbacks.
    const menuButton = button;
    const mobileMenu = menu;
    const menuIcon = icon;

    menuButton.dataset.initialized = 'true';

    // ------------------------------------------------------
    // Open / close the mobile navigation
    // ------------------------------------------------------
    function setOpen(open: boolean) {
      mobileMenu.hidden = !open;

      mobileMenu.classList.toggle(
        'hidden',
        !open
      );

      menuButton.setAttribute(
        'aria-expanded',
        String(open)
      );

      menuButton.setAttribute(
        'aria-label',
        open
          ? 'Close navigation menu'
          : 'Open navigation menu'
      );

      menuIcon.textContent = open ? '×' : '☰';
    }

    // Always start with the mobile menu closed.
    setOpen(false);

    // ------------------------------------------------------
    // Mobile menu button
    // ------------------------------------------------------
    menuButton.addEventListener('click', () => {
      const currentlyOpen =
        menuButton.getAttribute('aria-expanded') === 'true';

      setOpen(!currentlyOpen);
    });

    // ------------------------------------------------------
    // Close the menu after choosing a chapter
    // ------------------------------------------------------
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        setOpen(false);
      });
    });

    // ------------------------------------------------------
    // Escape key closes the mobile menu
    // ------------------------------------------------------
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
      }
    });

    // ------------------------------------------------------
    // Close the mobile menu when switching to desktop
    // ------------------------------------------------------
    const desktop = window.matchMedia(
      '(min-width: 1024px)'
    );

    desktop.addEventListener('change', (event) => {
      if (event.matches) {
        setOpen(false);
      }
    });
  }

  // Initial page load.
  setupMobileMenu();

  // Astro client-side navigation support.
  document.addEventListener(
    'astro:page-load',
    setupMobileMenu
  );
</script>