---
import { wisdomFruits } from '../data/treeOfWisdom';
---

<div class="wisdom-tree relative mx-auto w-full max-w-[560px]">
  <svg
    viewBox="0 0 360 390"
    class="h-auto w-full overflow-visible"
    xmlns="http://www.w3.org/2000/svg"
    role="group"
    aria-label="The Tree of Wisdom with four interactive social-link fruits"
  >
    <defs>
      <radialGradient id="wisdom-aura">
        <stop
          offset="0%"
          stop-color="#B5A2D0"
          stop-opacity="0.23"
        />
        <stop
          offset="100%"
          stop-color="#B5A2D0"
          stop-opacity="0"
        />
      </radialGradient>

      <filter id="fruit-glow">
        <feGaussianBlur stdDeviation="4" />
      </filter>
    </defs>

    <!-- Magical background -->
    <ellipse
      cx="180"
      cy="180"
      rx="170"
      ry="165"
      fill="url(#wisdom-aura)"
    />

    <!-- Ground shadow -->
    <ellipse
      cx="180"
      cy="353"
      rx="112"
      ry="11"
      fill="#B5A2D0"
      opacity="0.12"
    />

    <!-- Roots -->
    <g shape-rendering="crispEdges">
      <path
        d="M155 304 H205 V325 H218 V337
           H238 V347 H257 V356
           H103 V347 H122 V337 H142 V325 H155 Z"
        fill="#443649"
      />

      <path
        d="M156 321 H142 V334 H121 V345
           H109 V351 H155 Z"
        fill="#70566C"
      />

      <path
        d="M204 321 H218 V334 H239 V345
           H251 V351 H205 Z"
        fill="#70566C"
      />
    </g>

    <!-- Main trunk silhouette -->
    <path
      d="M151 176 H209 V321 H218 V337
         H231 V349 H129 V337 H142 V321 H151 Z"
      fill="#302A3B"
    />

    <!-- Trunk body -->
    <path
      d="M157 181 H203 V324 H212 V341
         H148 V324 H157 Z"
      fill="#80647A"
    />

    <!-- Major branches -->
    <g fill="#55415A">
      <path
        d="M160 239 H146 V206 H126 V181
           H111 V166 H124 V174 H154 V195 H170 Z"
      />

      <path
        d="M190 229 H205 V197 H227 V168
           H244 V151 H231 V162 H198 V188 H182 Z"
      />

      <path
        d="M164 270 H146 V245 H116 V228
           H100 V215 H116 V221 H158 Z"
      />

      <path
        d="M195 262 H212 V241 H241 V225
           H259 V212 H241 V217 H204 Z"
      />
    </g>

    <!-- Trunk bark highlights -->
    <g shape-rendering="crispEdges">
      <rect x="160" y="210" width="7" height="66" fill="#AA8A99" />
      <rect x="169" y="245" width="5" height="41" fill="#AA8A99" />
      <rect x="193" y="286" width="6" height="39" fill="#AA8A99" />

      <rect x="196" y="208" width="7" height="54" fill="#55415A" />
      <rect x="183" y="296" width="5" height="30" fill="#55415A" />
      <rect x="154" y="304" width="5" height="29" fill="#55415A" />

      <!-- Bark markings -->
      <rect x="176" y="261" width="12" height="4" fill="#5D485F" />
      <rect x="180" y="265" width="4" height="15" fill="#5D485F" />

      <rect x="173" y="308" width="15" height="4" fill="#5D485F" />
      <rect x="177" y="312" width="4" height="13" fill="#5D485F" />

      <rect x="160" y="287" width="9" height="4" fill="#5D485F" />
    </g>

    <!-- Canopy silhouette -->
    <path
      d="M136 41 H224 V54 H250 V71 H273 V92
         H290 V113 H304 V144 H294 V173
         H278 V198 H253 V218 H224 V231
         H139 V220 H108 V207 H83 V190
         H65 V167 H53 V133 H66 V103
         H84 V81 H109 V60 H136 Z"
      fill="#293A39"
      stroke="#1B262B"
      stroke-width="5"
      stroke-linejoin="miter"
    />

    <!-- Main canopy -->
    <path
      d="M140 48 H219 V62 H245 V79 H268 V100
         H284 V120 H296 V143 H286 V169
         H271 V193 H248 V211 H220 V223
         H144 V212 H113 V199 H89 V183
         H73 V163 H61 V135 H74 V109
         H90 V87 H114 V67 H140 Z"
      fill="#526C60"
    />

    <!-- Large shadow clusters -->
    <g fill="#374F48" shape-rendering="crispEdges">
      <rect x="75" y="145" width="43" height="30" />
      <rect x="91" y="173" width="50" height="25" />
      <rect x="121" y="194" width="64" height="23" />
      <rect x="203" y="191" width="49" height="26" />
      <rect x="252" y="150" width="33" height="32" />
      <rect x="219" y="88" width="48" height="29" />
      <rect x="145" y="64" width="50" height="23" />
      <rect x="183" y="114" width="46" height="25" />
    </g>

    <!-- Lighter leaf clusters -->
    <g fill="#769082" shape-rendering="crispEdges">
      <rect x="113" y="80" width="45" height="12" />
      <rect x="101" y="92" width="28" height="13" />
      <rect x="180" y="74" width="37" height="12" />
      <rect x="223" y="113" width="36" height="13" />
      <rect x="80" y="124" width="29" height="12" />
      <rect x="147" y="122" width="41" height="12" />
      <rect x="195" y="155" width="36" height="12" />
      <rect x="116" y="160" width="30" height="12" />
      <rect x="162" y="186" width="28" height="10" />
    </g>

    <!-- Small leaf details -->
    <g fill="#91A999" shape-rendering="crispEdges">
      <rect x="133" y="70" width="11" height="6" />
      <rect x="241" y="97" width="12" height="6" />
      <rect x="90" y="113" width="11" height="6" />
      <rect x="177" y="151" width="11" height="6" />
      <rect x="225" y="183" width="11" height="6" />
    </g>

    <!-- Magical lavender leaves -->
    <g fill="#B5A2D0" opacity="0.75" shape-rendering="crispEdges">
      <rect x="151" y="97" width="8" height="8" />
      <rect x="243" y="138" width="8" height="8" />
      <rect x="99" y="187" width="7" height="7" />
      <rect x="209" y="202" width="7" height="7" />
      <rect x="179" y="54" width="7" height="7" />
      <rect x="274" y="125" width="6" height="6" />
    </g>

    <!-- Hanging apple stems -->
    <g
      stroke="#A8C9A3"
      stroke-width="3"
      fill="none"
      shape-rendering="crispEdges"
    >
      <path d="M112 110 V118" />
      <path d="M244 97 V105" />
      <path d="M94 181 V190" />
      <path d="M259 177 V185" />
    </g>

    <!-- Interactive pixel apples -->
    {wisdomFruits.map((fruit) => (
      <a
        href={fruit.href}
        target={fruit.external ? '_blank' : undefined}
        rel={fruit.external ? 'noopener noreferrer' : undefined}
        aria-label={`${fruit.label}${fruit.external ? ' (opens in a new tab)' : ''}`}
        class="wisdom-fruit outline-none"
      >
        <g transform={`translate(${fruit.x} ${fruit.y})`}>
          <!-- Larger invisible tap target -->
          <rect
            x="-25"
            y="-27"
            width="50"
            height="55"
            fill="transparent"
          />

          <!-- Glow -->
          <rect
            class="fruit-glow"
            x="-21"
            y="-21"
            width="42"
            height="42"
            fill="#F1A4B1"
            filter="url(#fruit-glow)"
          />

          <!-- Pixel apple -->
          <g
            class="fruit-sprite"
            shape-rendering="crispEdges"
          >
            <!-- Stem -->
            <rect
              x="-2"
              y="-22"
              width="4"
              height="8"
              fill="#6A493F"
            />

            <!-- Leaf -->
            <rect
              x="3"
              y="-23"
              width="10"
              height="5"
              fill="#A8C9A3"
            />

            <rect
              x="7"
              y="-18"
              width="6"
              height="4"
              fill="#789F7C"
            />

            <!-- Outer apple silhouette -->
            <path
              d="M-13 -14 H-5 V-11 H5 V-14 H13
                 V-10 H18 V-3 H20 V11 H15
                 V17 H6 V20 H-6 V17 H-15
                 V11 H-20 V-3 H-18 V-10 H-13 Z"
              fill="#3B2938"
            />

            <!-- Apple body -->
            <path
              d="M-13 -11 H-5 V-8 H5 V-11 H13
                 V-7 H15 V-1 H17 V10 H12
                 V14 H5 V17 H-5 V14 H-12
                 V10 H-17 V-1 H-15 V-7 H-13 Z"
              fill="#E9A0A8"
            />

            <!-- Shine -->
            <rect
              x="-12"
              y="-6"
              width="5"
              height="9"
              fill="#FFD0D1"
            />

            <rect
              x="-7"
              y="-10"
              width="5"
              height="4"
              fill="#FFD0D1"
            />

            <!-- Shadow -->
            <rect
              x="11"
              y="1"
              width="5"
              height="8"
              fill="#C9748E"
            />

            <rect
              x="5"
              y="12"
              width="7"
              height="4"
              fill="#C9748E"
            />

            <!-- Platform symbol -->
            <text
              x="0"
              y="6"
              fill="#302A3B"
              font-family="monospace"
              font-size="12"
              font-weight="900"
              text-anchor="middle"
              aria-hidden="true"
            >
              {fruit.symbol}
            </text>
          </g>

          <!-- Tooltip -->
          <g class="fruit-tooltip" aria-hidden="true">
            <rect
              x="-46"
              y="-58"
              width="92"
              height="24"
              fill="#262E3D"
              stroke="#B5A2D0"
              stroke-width="2"
            />

            <text
              x="0"
              y="-42"
              fill="#ECEAE4"
              font-family="monospace"
              font-size="11"
              font-weight="bold"
              text-anchor="middle"
            >
              {fruit.label}
            </text>
          </g>
        </g>
      </a>
    ))}

    <!-- Floating magic particles -->
    <g fill="#B5A2D0" opacity="0.7" shape-rendering="crispEdges">
      <rect x="30" y="85" width="5" height="5" />
      <rect x="319" y="107" width="4" height="4" />
      <rect x="42" y="247" width="4" height="4" />
      <rect x="314" y="265" width="5" height="5" />
      <rect x="179" y="15" width="4" height="4" />
    </g>
  </svg>
</div>

<style>
  .wisdom-tree {
    animation: tree-float 7s ease-in-out infinite;
  }

  .wisdom-fruit {
    cursor: pointer;
  }

  .fruit-sprite {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .fruit-glow {
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .fruit-tooltip {
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .wisdom-fruit:hover .fruit-sprite,
  .wisdom-fruit:focus-visible .fruit-sprite {
    transform: scale(1.16);
  }

  .wisdom-fruit:hover .fruit-glow,
  .wisdom-fruit:focus-visible .fruit-glow {
    opacity: 0.65;
  }

  .wisdom-fruit:hover .fruit-tooltip,
  .wisdom-fruit:focus-visible .fruit-tooltip {
    opacity: 1;
  }

  .wisdom-fruit:focus-visible .fruit-sprite {
    filter: drop-shadow(0 0 5px #B5A2D0);
  }

  @keyframes tree-float {
    0%, 100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wisdom-tree {
      animation: none;
    }

    .fruit-sprite,
    .fruit-glow,
    .fruit-tooltip {
      transition: none;
    }
  }
</style>