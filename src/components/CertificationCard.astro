---
import type { Certification } from '../data/certifications';

interface Props {
  certification: Certification;
  index?: number;
}

const { certification, index = 0 } = Astro.props;

// Format YYYY-MM into a readable month and year.
const [year, month] = certification.date.split('-').map(Number);

const formattedDate =
  Number.isInteger(year) &&
  Number.isInteger(month) &&
  month >= 1 &&
  month <= 12
    ? new Intl.DateTimeFormat('en-US', {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(Date.UTC(year, month - 1, 1)))
    : certification.date;

// Only display the credential link when a URL exists.
const credentialUrl = certification.driveUrl?.trim();
---

<article class="pixel-panel flex h-full flex-col gap-4 p-5 sm:p-6">
  <!-- Icon and index -->
  <div class="flex items-start justify-between gap-4">
    <span
      class="text-2xl text-accent"
      aria-hidden="true"
    >
      ✧
    </span>

    <span class="font-ui text-xs text-muted">
      {String(index + 1).padStart(2, '0')}
    </span>
  </div>

  <!-- Certificate information -->
  <div class="space-y-2">
    <h3 class="text-lg font-semibold leading-snug text-foreground">
      {certification.title}
    </h3>

    <p class="font-ui text-sm text-accent">
      {certification.issuer}
    </p>

    <p class="text-sm leading-relaxed text-muted">
      {certification.description}
    </p>
  </div>

  <!-- Skill tags -->
  {certification.tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {certification.tags.map((tag) => (
        <span
          class="border border-outline bg-background
                 px-2.5 py-1 font-ui text-xs text-muted"
        >
          {tag}
        </span>
      ))}
    </div>
  )}

  <!-- Date and optional credential link -->
  <div
    class="mt-auto flex items-center justify-between gap-3
           border-t border-outline pt-4"
  >
    <time
      datetime={certification.date}
      class="font-ui text-xs text-muted"
    >
      {formattedDate}
    </time>

    {credentialUrl && (
      <a
        href={credentialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 w-10 items-center justify-center
               border border-outline text-accent
               transition-colors hover:bg-background
               focus-visible:outline-2
               focus-visible:outline-offset-2
               focus-visible:outline-accent"
        aria-label={`View certificate: ${certification.title} (opens in a new tab)`}
        title="View certificate"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6" />
        </svg>
      </a>
    )}
  </div>
</article>