---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ELI.EXE',
  description = 'A personal portfolio about code, creativity, and exploration.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="midnight">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191f2b" />
    <title>{title}</title>

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('eli-theme');

          if (saved === 'midnight' || saved === 'daybreak') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          // Use the default theme.
        }
      })();
    </script>
  </head>

  <body>
    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <footer class="border-t border-outline py-8">
      <div
        class="section-container font-ui flex flex-wrap items-center justify-between gap-3 text-xs text-muted"
      >
        <span>© {new Date().getFullYear()} ELI.EXE</span>
        <span>MADE WITH CURIOSITY ✦</span>
      </div>
    </footer>
  </body>
</html>