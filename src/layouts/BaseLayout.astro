---
import '../styles/global.css';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SoundController from '../components/SoundController.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ELI.EXE',
  description = 'A personal portfolio about code, creativity, and exploration.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="midnight">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191f2b" />
    <title>{title}</title>

    <!-- Restore the visitor's preferred theme -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('eli-theme');

          if (saved === 'midnight' || saved === 'daybreak') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          // Use the default theme.
        }
      })();
    </script>
  </head>

  <body>
    <!-- Main navigation -->
    <Navbar />

    <!-- Portfolio content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Full portfolio footer -->
    <Footer />

    <!-- Global sound effects controller -->
    <SoundController />
  </body>
</html>