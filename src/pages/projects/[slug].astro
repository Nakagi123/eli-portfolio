---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  allProjects,
  type Project,
} from '../../data/projects';

interface Props {
  project: Project;
  index: number;
}

export function getStaticPaths() {
  return allProjects.map((project, index) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
      index,
    },
  }));
}

const { project, index } = Astro.props;

const rarityLabels = {
  common: 'COMMON ARTIFACT',
  rare: 'RARE ARTIFACT',
  epic: 'EPIC ARTIFACT',
  legendary: 'LEGENDARY ARTIFACT',
};

const rarityColors = {
  common: 'text-foreground/70',
  rare: 'text-sky-300',
  epic: 'text-accent',
  legendary: 'text-amber-300',
};

const itemNumber = String(index + 1).padStart(3, '0');

const hasStory =
  project.challenge ||
  project.solution ||
  project.lessons;

const hasLinks = project.github || project.demo;

const hasScreenshots =
  project.screenshots && project.screenshots.length > 0;
---

<BaseLayout
  title={`${project.title} | ELI.EXE`}
  description={project.summary}
>
  <div class="min-h-screen py-12 sm:py-20">
    <div class="section-container">

      <!-- Back navigation -->
      <a
        href="/#projects"
        class="font-ui group inline-flex items-center gap-2 text-xs text-accent transition-colors hover:text-foreground"
      >
        <span
          aria-hidden="true"
          class="transition-transform group-hover:-translate-x-1"
        >
          ←
        </span>
        RETURN TO INVENTORY
      </a>

      <!-- Page header -->
      <div class="mt-10 flex flex-wrap items-start justify-between gap-4 border-b border-outline pb-6">
        <div class="space-y-3">
          <p class="font-pixel text-[10px] tracking-wider text-accent">
            ✦ ARTIFACT INSPECTION
          </p>

          <h1
            class="font-pixel text-2xl leading-relaxed text-foreground sm:text-4xl"
          >
            {project.title}
          </h1>

          <p class="font-ui text-sm text-foreground/70">
            {project.category}
          </p>
        </div>

        <div class="text-right">
          <p class="font-ui text-xs text-foreground/60">
            ITEM #{itemNumber}
          </p>

          <p
            class={`mt-2 font-pixel text-[9px] ${rarityColors[project.rarity]}`}
          >
            {rarityLabels[project.rarity]}
          </p>
        </div>
      </div>

      <!-- Main inspection layout -->
      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(280px,0.7fr)]">

        <!-- Left: artifact display and story -->
        <div class="min-w-0 space-y-8">

          <!-- Artifact preview -->
          <div class="pixel-panel overflow-hidden p-3 sm:p-5">
            <div class="mb-4 flex items-center justify-between gap-2">
              <p class="font-pixel text-[9px] text-accent">
                [ ARTIFACT PREVIEW ]
              </p>

              <span class="font-ui text-[10px] text-foreground/50">
                ELI.EXE / ARCHIVE
              </span>
            </div>

            <div
              class="flex aspect-video items-center justify-center overflow-hidden border border-outline bg-background"
            >
              {
                project.image ? (
                  <img
                    src={project.image}
                    alt={`Preview of ${project.title}`}
                    class="h-full w-full object-contain"
                  />
                ) : (
                  <div class="flex flex-col items-center gap-4">
                    <span
                      class="text-6xl sm:text-7xl"
                      aria-hidden="true"
                    >
                      {project.icon.startsWith('/') ? (
                        <img
                          src={project.icon}
                          alt=""
                          class="h-20 w-20 object-contain [image-rendering:pixelated]"
                        />
                      ) : (
                        project.icon
                      )}
                    </span>

                    <p class="font-pixel text-[9px] text-accent">
                      ARTIFACT DISCOVERED
                    </p>
                  </div>
                )
              }
            </div>
          </div>

          <!-- Description -->
          <section
            aria-labelledby="overview-heading"
            class="space-y-4"
          >
            <h2
              id="overview-heading"
              class="font-pixel text-sm text-accent"
            >
              01 / THE ARTIFACT
            </h2>

            <p class="font-ui text-sm leading-8 text-foreground/85">
              {project.description}
            </p>
          </section>

          <!-- Highlights -->
          {
            project.highlights &&
            project.highlights.length > 0 && (
              <section
                aria-labelledby="highlights-heading"
                class="space-y-4 border-t border-outline pt-8"
              >
                <h2
                  id="highlights-heading"
                  class="font-pixel text-sm text-accent"
                >
                  02 / SPECIAL ABILITIES
                </h2>

                <ul class="space-y-3">
                  {project.highlights.map((highlight) => (
                    <li class="font-ui flex items-start gap-3 text-sm leading-relaxed text-foreground/85">
                      <span
                        class="mt-0.5 text-accent"
                        aria-hidden="true"
                      >
                        ✦
                      </span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <!-- Development story -->
          {
            hasStory && (
              <section
                aria-labelledby="story-heading"
                class="space-y-5 border-t border-outline pt-8"
              >
                <h2
                  id="story-heading"
                  class="font-pixel text-sm text-accent"
                >
                  03 / THE QUEST LOG
                </h2>

                {project.challenge && (
                  <div class="space-y-2">
                    <h3 class="font-ui text-xs font-semibold uppercase tracking-wider text-foreground">
                      The Challenge
                    </h3>
                    <p class="font-ui text-sm leading-7 text-foreground/75">
                      {project.challenge}
                    </p>
                  </div>
                )}

                {project.solution && (
                  <div class="space-y-2">
                    <h3 class="font-ui text-xs font-semibold uppercase tracking-wider text-foreground">
                      The Approach
                    </h3>
                    <p class="font-ui text-sm leading-7 text-foreground/75">
                      {project.solution}
                    </p>
                  </div>
                )}

                {project.lessons && (
                  <div class="space-y-2">
                    <h3 class="font-ui text-xs font-semibold uppercase tracking-wider text-foreground">
                      Lessons Unlocked
                    </h3>
                    <p class="font-ui text-sm leading-7 text-foreground/75">
                      {project.lessons}
                    </p>
                  </div>
                )}
              </section>
            )
          }

          <!-- Screenshot gallery -->
          {
            hasScreenshots && (
              <section
                aria-labelledby="gallery-heading"
                class="space-y-5 border-t border-outline pt-8"
              >
                <h2
                  id="gallery-heading"
                  class="font-pixel text-sm text-accent"
                >
                  04 / MEMORY FRAGMENTS
                </h2>

                <div class="grid gap-4 sm:grid-cols-2">
                  {project.screenshots!.map((screenshot, i) => (
                    <a
                      href={screenshot}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block overflow-hidden border border-outline bg-surface transition-colors hover:border-accent focus-visible:outline-2 focus-visible:outline-accent"
                      aria-label={`Open screenshot ${i + 1} of ${project.title}`}
                    >
                      <img
                        src={screenshot}
                        alt={`${project.title} screenshot ${i + 1}`}
                        loading="lazy"
                        class="aspect-video w-full object-cover"
                      />
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </div>

        <!-- Right: item stats -->
        <aside class="min-w-0">
          <div class="pixel-panel space-y-6 p-5 lg:sticky lg:top-28">
            <div class="border-b border-outline pb-4">
              <p class="font-pixel text-[10px] text-accent">
                ✦ ITEM INFORMATION
              </p>

              <p class="mt-3 font-ui text-xs leading-relaxed text-foreground/75">
                {project.summary}
              </p>
            </div>

            <!-- Metadata -->
            <dl class="space-y-4">
              {
                project.role && (
                  <div>
                    <dt class="font-pixel text-[9px] text-accent">
                      PLAYER ROLE
                    </dt>
                    <dd class="mt-2 font-ui text-sm text-foreground">
                      {project.role}
                    </dd>
                  </div>
                )
              }

              {
                project.year && (
                  <div>
                    <dt class="font-pixel text-[9px] text-accent">
                      DISCOVERY YEAR
                    </dt>
                    <dd class="mt-2 font-ui text-sm text-foreground">
                      {project.year}
                    </dd>
                  </div>
                )
              }

              <div>
                <dt class="font-pixel text-[9px] text-accent">
                  ARTIFACT CLASS
                </dt>
                <dd class="mt-2 font-ui text-sm text-foreground">
                  {project.category}
                </dd>
              </div>
            </dl>

            <!-- Technologies -->
            <div class="border-t border-outline pt-5">
              <h2 class="font-pixel text-[9px] text-accent">
                EQUIPPED TECHNOLOGIES
              </h2>

              <div class="mt-4 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <span
                    class="border border-outline bg-background px-3 py-2 font-ui text-xs text-foreground/85"
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- External links -->
            {
              hasLinks && (
                <div class="space-y-3 border-t border-outline pt-5">
                  <h2 class="font-pixel text-[9px] text-accent">
                    ARTIFACT PORTALS
                  </h2>

                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pixel-button flex w-full items-center justify-center gap-2"
                    >
                      VIEW SOURCE CODE ↗
                    </a>
                  )}

                  {project.demo && (
                    <a
                      href={project.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pixel-button flex w-full items-center justify-center gap-2"
                    >
                      LAUNCH PROJECT ↗
                    </a>
                  )}
                </div>
              )
            }
          </div>
        </aside>
      </div>

      <!-- Bottom navigation -->
      <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-outline pt-6">
        <a
          href="/#projects"
          class="font-ui text-xs text-accent transition-colors hover:text-foreground"
        >
          ← RETURN TO THE CHEST
        </a>

        <a
          href="/projects"
          class="font-ui text-xs text-accent transition-colors hover:text-foreground"
        >
          VIEW ALL ARTIFACTS →
        </a>
      </div>
    </div>
</div>
</BaseLayout>