---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allProjects } from '../../data/projects';

const categories = [
  ...new Set(allProjects.map((project) => project.category)),
];

const rarityStyles = {
  common: 'border-outline text-foreground/65',
  rare: 'border-sky-400/40 text-sky-300',
  epic: 'border-violet-400/40 text-violet-300',
  legendary: 'border-amber-400/40 text-amber-300',
};
---

<BaseLayout
  title="The Artifact Codex | ELI.EXE"
  description="Explore the complete collection of projects, experiments, and creations crafted by Elian Malik."
>
  <div class="min-h-screen bg-background text-foreground">
    <div class="section-container py-16 sm:py-24">

      <!-- BACK NAVIGATION -->
      <a
        href="/#projects"
        class="mb-12 inline-flex items-center gap-2 font-ui text-xs text-foreground/60 transition-colors hover:text-accent"
      >
        <span aria-hidden="true">←</span>
        RETURN TO THE TREASURE CHEST
      </a>

      <!-- PAGE HEADER -->
      <header class="mb-12 max-w-3xl">
        <p class="mb-4 font-ui text-xs tracking-[0.25em] text-accent">
          ELI.EXE / COMPLETE COLLECTION
        </p>

        <h1 class="mb-5 font-pixel text-2xl leading-relaxed text-foreground sm:text-3xl md:text-4xl">
          THE ARTIFACT CODEX
        </h1>

        <p class="max-w-2xl text-sm leading-8 text-foreground/70 sm:text-base">
          Every artifact tells a story. Browse the complete collection
          of projects, experiments, and ideas gathered throughout my journey.
        </p>
      </header>

      <!-- COLLECTION STATS -->
      <div class="mb-10 grid grid-cols-2 gap-3 sm:max-w-lg">
        <div class="pixel-panel p-5">
          <p class="font-ui text-xs tracking-widest text-foreground/50">
            ARTIFACTS FOUND
          </p>

          <p class="mt-3 font-pixel text-2xl text-accent">
            {String(allProjects.length).padStart(2, '0')}
          </p>
        </div>

        <div class="pixel-panel p-5">
          <p class="font-ui text-xs tracking-widest text-foreground/50">
            COLLECTION TYPES
          </p>

          <p class="mt-3 font-pixel text-2xl text-accent">
            {String(categories.length).padStart(2, '0')}
          </p>
        </div>
      </div>

      <!-- CATEGORY FILTERS -->
      <div class="mb-8">
        <p
          id="category-filter-label"
          class="mb-4 font-ui text-xs tracking-[0.2em] text-foreground/55"
        >
          FILTER BY ARTIFACT TYPE
        </p>

        <div
          class="flex flex-wrap gap-2"
          role="group"
          aria-labelledby="category-filter-label"
          data-project-filters
        >
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="artifact-filter is-active"
          >
            ALL ARTIFACTS
          </button>

          {
            categories.map((category) => (
              <button
                type="button"
                data-filter={category}
                aria-pressed="false"
                class="artifact-filter"
              >
                {category}
              </button>
            ))
          }
        </div>
      </div>

      <!-- RESULTS COUNTER -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <p
          class="font-ui text-xs tracking-widest text-foreground/55"
          aria-live="polite"
          data-project-count
        >
          SHOWING {allProjects.length} OF {allProjects.length} ARTIFACTS
        </p>

        <span
          class="font-ui text-xs tracking-widest text-accent/70"
          aria-hidden="true"
        >
          ✦ COLLECTION UNLOCKED
        </span>
      </div>

      <!-- PROJECT GRID -->
      <div
        class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3"
        data-project-grid
      >
        {
          allProjects.map((project, index) => (
            <article
              class="artifact-card pixel-panel group flex h-full flex-col overflow-hidden"
              data-project-card
              data-category={project.category}
            >
              <!-- PREVIEW -->
              <a
                href={`/projects/${project.slug}`}
                class="relative block overflow-hidden border-b border-outline bg-surface"
                aria-label={`Inspect ${project.title}`}
              >
                <div class="flex aspect-[16/10] items-center justify-center overflow-hidden">
                  {project.image ? (
                    <img
                      src={project.image}
                      alt={`${project.title} preview`}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : project.icon.startsWith('/') ? (
                    <img
                      src={project.icon}
                      alt=""
                      loading="lazy"
                      class="h-24 w-24 object-contain [image-rendering:pixelated] transition-transform duration-500 group-hover:scale-110"
                    />
                  ) : (
                    <span
                      class="text-7xl transition-transform duration-500 group-hover:scale-110"
                      aria-hidden="true"
                    >
                      {project.icon}
                    </span>
                  )}
                </div>

                <span class="absolute left-4 top-4 border border-outline bg-background/90 px-3 py-2 font-ui text-[10px] tracking-widest text-foreground/75">
                  ITEM {String(index + 1).padStart(2, '0')}
                </span>
              </a>

              <!-- CARD CONTENT -->
              <div class="flex flex-1 flex-col p-5 sm:p-6">
                <div class="mb-4 flex flex-wrap items-center gap-2">
                  <span
                    class={`border px-2 py-1 font-ui text-[10px] tracking-widest uppercase ${rarityStyles[project.rarity]}`}
                  >
                    ✦ {project.rarity}
                  </span>

                  <span class="font-ui text-[10px] tracking-widest text-foreground/45">
                    {project.category}
                  </span>
                </div>

                <h2 class="mb-3 font-pixel text-sm leading-7 text-foreground sm:text-base">
                  <a
                    href={`/projects/${project.slug}`}
                    class="transition-colors hover:text-accent"
                  >
                    {project.title}
                  </a>
                </h2>

                <p class="mb-6 flex-1 text-sm leading-7 text-foreground/65">
                  {project.summary}
                </p>

                <!-- TECHNOLOGIES -->
                <div class="mb-6 flex flex-wrap gap-2">
                  {
                    project.technologies.map((technology) => (
                      <span class="border border-outline bg-background/50 px-2 py-1 font-ui text-[10px] text-foreground/65">
                        {technology}
                      </span>
                    ))
                  }
                </div>

                <!-- INSPECT LINK -->
                <a
                  href={`/projects/${project.slug}`}
                  class="inline-flex items-center justify-between border-t border-outline pt-4 font-ui text-xs tracking-widest text-accent transition-colors hover:text-foreground"
                >
                  INSPECT ARTIFACT
                  <span
                    class="transition-transform group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <!-- EMPTY STATE -->
      <div
        class="pixel-panel mt-6 hidden p-10 text-center"
        data-project-empty
      >
        <p class="mb-3 text-4xl" aria-hidden="true">🗝️</p>
        <p class="font-pixel text-sm text-accent">
          NO ARTIFACTS FOUND
        </p>
        <p class="mt-3 text-sm text-foreground/60">
          Try exploring another category.
        </p>
      </div>

      <!-- FOOTER NAVIGATION -->
      <div class="mt-16 border-t border-outline pt-8">
        <a
          href="/#projects"
          class="inline-flex items-center gap-3 font-ui text-xs tracking-widest text-accent transition-colors hover:text-foreground"
        >
          <span aria-hidden="true">←</span>
          RETURN TO THE TREASURE CHEST
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initializeArtifactFilters() {
    const filterContainer = document.querySelector(
      '[data-project-filters]'
    );

    const grid = document.querySelector('[data-project-grid]');

    if (!(filterContainer instanceof HTMLElement)) return;
    if (!(grid instanceof HTMLElement)) return;

    const buttons = Array.from(
      filterContainer.querySelectorAll<HTMLButtonElement>(
        '[data-filter]'
      )
    );

    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>('[data-project-card]')
    );

    const counter = document.querySelector<HTMLElement>(
      '[data-project-count]'
    );

    const emptyState = document.querySelector<HTMLElement>(
      '[data-project-empty]'
    );

    function applyFilter(category: string) {
      let visibleCount = 0;

      cards.forEach((card) => {
        const matches =
          category === 'all' ||
          card.dataset.category === category;

        card.hidden = !matches;

        if (matches) visibleCount++;
      });

      buttons.forEach((button) => {
        const isActive = button.dataset.filter === category;

        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      if (counter) {
        counter.textContent =
          `SHOWING ${visibleCount} OF ${cards.length} ARTIFACTS`;
      }

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
        emptyState.classList.toggle(
          'hidden',
          visibleCount !== 0
        );
      }
    }

    // Event delegation avoids duplicate button listeners.
    filterContainer.onclick = (event) => {
      if (!(event.target instanceof Element)) return;

      const button = event.target.closest<HTMLButtonElement>(
        '[data-filter]'
      );

      if (!button || !filterContainer.contains(button)) return;

      applyFilter(button.dataset.filter ?? 'all');
    };

    applyFilter('all');
  }

  initializeArtifactFilters();

  document.addEventListener(
    'astro:page-load',
    initializeArtifactFilters
  );
</script>

<style>
  .artifact-filter {
    border: 1px solid var(--color-outline);
    background: transparent;
    color: var(--color-foreground);
    opacity: 0.65;
    padding: 0.7rem 0.95rem;
    font-family: var(--font-ui), monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      opacity 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .artifact-filter:hover,
  .artifact-filter:focus-visible {
    opacity: 1;
    border-color: var(--color-accent);
  }

  .artifact-filter.is-active {
    opacity: 1;
    border-color: var(--color-accent);
    background: color-mix(
      in srgb,
      var(--color-accent) 12%,
      transparent
    );
    color: var(--color-accent);
  }

  .artifact-card {
    transition:
      transform 220ms ease,
      border-color 220ms ease;
  }

  .artifact-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .artifact-card[hidden] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .artifact-filter,
    .artifact-card {
      transition: none;
    }

    .artifact-card:hover {
      transform: none;
    }
  }
</style>