---
import TreasureChest from '../components/TreasureChest.astro';
import ProjectInventory from '../components/ProjectInventory.astro';
import { featuredProjects } from '../data/projects';
---

<section
  id="projects"
  aria-labelledby="projects-title"
  class="relative py-20 sm:py-28"
>
  <div class="section-container">
    <!-- Chapter heading -->
    <div class="mx-auto mb-10 max-w-2xl space-y-4 text-center">
      <p class="font-ui text-xs tracking-[0.2em] text-accent">
        [ CHAPTER 02 — THE WORK ARCHIVE ]
      </p>

      <h2
        id="projects-title"
        class="font-pixel text-2xl leading-relaxed text-foreground sm:text-3xl"
      >
        THE CHEST OF CREATIONS.
      </h2>

      <p class="text-foreground/80">
        Every artifact holds a story. Unlock the chest to discover mine.
      </p>
    </div>

    <!-- Enchanted project vault -->
    <div
      data-project-vault
      class="flex flex-col items-center"
    >
      <!-- Inventory expands ABOVE the chest -->
      <div
        data-inventory-wrapper
        class="inventory-wrapper grid w-full max-w-[650px] grid-rows-[0fr] transition-[grid-template-rows] duration-500"
      >
        <!-- Clip inventory only during opening/closing -->
        <div
          data-inventory-clip
          class="inventory-clip min-h-0 overflow-hidden"
        >
          <ProjectInventory projects={featuredProjects} />
        </div>
      </div>

      <!-- Interactive treasure chest -->
      <TreasureChest />
    </div>
  </div>
</section>

<script>
  function setupProjectVault() {
    const vault = document.querySelector<HTMLElement>(
      '[data-project-vault]'
    );

    if (!vault || vault.dataset.initialized === 'true') {
      return;
    }

    const chest = vault.querySelector<HTMLElement>(
      '[data-treasure-chest]'
    );

    const button = vault.querySelector<HTMLButtonElement>(
      '[data-chest-toggle]'
    );

    const inventory = vault.querySelector<HTMLElement>(
      '[data-project-inventory]'
    );

    const wrapper = vault.querySelector<HTMLElement>(
      '[data-inventory-wrapper]'
    );

    const clip = vault.querySelector<HTMLElement>(
      '[data-inventory-clip]'
    );

    // Stop if any required element is missing.
    if (!chest || !button || !inventory || !wrapper || !clip) {
      return;
    }

    // Stable references prevent TypeScript null errors
    // inside nested functions and event callbacks.
    const chestElement = chest;
    const buttonElement = button;
    const inventoryElement = inventory;
    const wrapperElement = wrapper;
    const clipElement = clip;

    vault.dataset.initialized = 'true';

    buttonElement.setAttribute(
      'aria-controls',
      'project-inventory'
    );

    let isOpen = chestElement.classList.contains('is-open');

    // ------------------------------------------------------
    // Synchronize the chest and inventory
    // ------------------------------------------------------
    function syncInventory(open: boolean) {
      isOpen = open;

      // Show or hide the inventory.
      inventoryElement.classList.toggle('is-visible', open);
      inventoryElement.inert = !open;

      // Animate the inventory's height.
      wrapperElement.classList.toggle(
        'grid-rows-[1fr]',
        open
      );

      wrapperElement.classList.toggle(
        'grid-rows-[0fr]',
        !open
      );

      // Clip content while the inventory animates.
      wrapperElement.classList.remove('is-expanded');

      clipElement.classList.remove('overflow-visible');
      clipElement.classList.add('overflow-hidden');
    }

    // ------------------------------------------------------
    // Release clipping after the opening animation
    // ------------------------------------------------------
    wrapperElement.addEventListener(
      'transitionend',
      (event) => {
        if (
          event.target !== wrapperElement ||
          event.propertyName !== 'grid-template-rows'
        ) {
          return;
        }

        if (isOpen) {
          wrapperElement.classList.add('is-expanded');

          clipElement.classList.remove('overflow-hidden');
          clipElement.classList.add('overflow-visible');
        }
      }
    );

    // ------------------------------------------------------
    // React to the chest's toggle button
    // ------------------------------------------------------
    buttonElement.addEventListener('click', () => {
      // TreasureChest handles its own .is-open class.
      const open = chestElement.classList.contains('is-open');

      syncInventory(open);
    });

    // ------------------------------------------------------
    // Reduced-motion accessibility
    // ------------------------------------------------------
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    function applyReducedMotion() {
      if (reducedMotion.matches && isOpen) {
        wrapperElement.classList.add('is-expanded');

        clipElement.classList.remove('overflow-hidden');
        clipElement.classList.add('overflow-visible');
      }
    }

    reducedMotion.addEventListener(
      'change',
      applyReducedMotion
    );

    // Initialize the inventory state.
    syncInventory(isOpen);
    applyReducedMotion();
  }

  // Initial page load.
  setupProjectVault();

  // Reinitialize after Astro client-side navigation.
  document.addEventListener(
    'astro:page-load',
    setupProjectVault
  );
</script>

<style>
  .inventory-wrapper {
    position: relative;
  }

  /* Allow tooltips to extend beyond the inventory
     after the opening animation finishes. */
  .inventory-wrapper.is-expanded {
    overflow: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .inventory-wrapper {
      transition: none;
    }
  }
</style>