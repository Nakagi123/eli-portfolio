---
import PixelDoor from '../components/PixelDoor.astro';
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="relative isolate flex min-h-[100svh] flex-col
         overflow-hidden bg-background"
>
  <!-- Ambient background -->
  <div
    class="hero-ambient pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  ></div>

  <!-- Decorative pixel stars -->
  <div
    class="pointer-events-none absolute inset-0 overflow-hidden"
    aria-hidden="true"
  >
    <span class="hero-star left-[12%] top-[24%]"></span>
    <span class="hero-star left-[83%] top-[20%]"></span>
    <span class="hero-star left-[19%] top-[64%]"></span>
    <span class="hero-star left-[76%] top-[70%]"></span>
    <span class="hero-star left-[48%] top-[13%]"></span>
  </div>

  <!-- Main content -->
  <div
    class="section-container relative z-10 flex w-full
           flex-1 flex-col items-center justify-center
           pb-12 pt-24 text-center sm:pb-14 sm:pt-28
           lg:pb-16"
  >
    <!-- Eyebrow -->
    <p
      class="mb-3 font-ui text-[11px] uppercase
             tracking-[0.18em] text-accent sm:text-xs"
    >
      ✦ PLAYER ONE HAS ENTERED THE WORLD ✦
    </p>

    <!-- Portal and overlapping wordmark -->
    <div
      class="relative flex w-full max-w-5xl
             items-center justify-center"
    >
      <div
        class="hero-portal pointer-events-none relative
               w-[min(78vw,340px)]
               sm:w-[390px]
               lg:w-[500px]"
        aria-hidden="true"
      >
        <div
          class="hero-portal-glow absolute
                 inset-[10%_-35%]"
        ></div>

        <PixelDoor />
      </div>


        <h1
        id="hero-title"
        class="hero-wordmark pointer-events-none
                absolute left-1/2 top-[48%] z-10
                w-max max-w-full
                -translate-x-1/2 -translate-y-1/2
                font-pixel text-foreground
                text-[clamp(3.5rem,16vw,5rem)]
                sm:text-[clamp(5rem,12vw,10rem)]
                leading-none tracking-[-0.09em]"
        >
        ELI<span class="text-accent">.</span>EXE
        </h1>
    </div>

    <!-- Introduction -->
    <div
      class="relative z-20 -mt-2 flex max-w-2xl
             flex-col items-center gap-4 sm:mt-0"
    >
      <p
        class="font-ui text-[11px] uppercase
               tracking-[0.16em] text-accent sm:text-xs"
      >
        A LITTLE CURIOUS. ALWAYS EXPLORING.
      </p>

      <p
        class="max-w-xl text-base leading-relaxed
               text-foreground/90 sm:text-lg lg:text-xl"
      >
        Hey, I'm Eli. I build things where{' '}
        <span class="font-semibold text-foreground">
          code meets creativity.
        </span>
      </p>

      <p
        class="font-ui text-xs text-foreground/80
               sm:text-sm"
      >
        Developer · Explorer · Always learning
      </p>

      <!-- Actions -->
      <div
        class="mt-3 flex flex-wrap items-center
               justify-center gap-3"
      >
        <a
          href="#work"
          class="pixel-button inline-flex min-h-12
                 items-center justify-center gap-2
                 px-5 py-3 font-ui text-xs
                 uppercase tracking-wider"
        >
          EXPLORE MY WORK
          <span aria-hidden="true">↗</span>
        </a>

        <a
          href="#contact"
          class="inline-flex min-h-12 items-center
                 justify-center border border-outline
                 bg-surface px-5 py-3 font-ui text-xs
                 uppercase tracking-wider
                 text-foreground transition-colors
                 hover:border-accent hover:text-accent
                 focus-visible:outline-2
                 focus-visible:outline-offset-2
                 focus-visible:outline-accent"
        >
          CONTACT ME
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll cue: in normal layout flow to avoid overlap -->
  <a
    href="#skills"
    class="relative z-20 mx-auto mb-5 flex
           shrink-0 flex-col items-center gap-1
           px-3 py-2 text-center
           font-ui text-[11px] uppercase
           tracking-[0.14em] text-foreground/80
           transition-colors hover:text-accent
           focus-visible:outline-2
           focus-visible:outline-accent"
  >
    <span>SCROLL TO BEGIN</span>
    <span
      class="hero-scroll-arrow text-lg text-accent"
      aria-hidden="true"
    >
      ↓
    </span>
  </a>
</section>

<style>
  .hero-ambient {
    background: radial-gradient(
      ellipse 34% 48% at 50% 43%,
      color-mix(
        in srgb,
        var(--color-accent) 12%,
        transparent
      ),
      transparent 80%
    );
  }

  .hero-portal {
    animation: portal-float 7s ease-in-out infinite;
  }

  .hero-portal-glow {
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      color-mix(
        in srgb,
        var(--color-accent) 25%,
        transparent
      ),
      transparent 68%
    );
    filter: blur(30px);
    animation: portal-breathe 5s ease-in-out infinite;
  }

  .hero-wordmark {
    text-shadow:
      0 3px 0 var(--color-background),
      0 0 32px color-mix(
        in srgb,
        var(--color-accent) 12%,
        transparent
      );
  }

  .hero-star {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--color-accent);
    opacity: 0.4;
    animation: star-twinkle 4s ease-in-out infinite;
  }

  .hero-star:nth-child(2) {
    animation-delay: 0.8s;
  }

  .hero-star:nth-child(3) {
    animation-delay: 1.6s;
  }

  .hero-star:nth-child(4) {
    animation-delay: 2.4s;
  }

  .hero-star:nth-child(5) {
    animation-delay: 3.2s;
  }

  .hero-scroll-arrow {
    animation: scroll-bob 2s ease-in-out infinite;
  }

  @keyframes portal-float {
    0%, 100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-9px);
    }
  }

  @keyframes portal-breathe {
    0%, 100% {
      opacity: 0.55;
      transform: scale(0.95);
    }

    50% {
      opacity: 0.95;
      transform: scale(1.08);
    }
  }

  @keyframes star-twinkle {
    0%, 100% {
      opacity: 0.2;
    }

    50% {
      opacity: 0.75;
    }
  }

  @keyframes scroll-bob {
    0%, 100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(5px);
    }
  }

  /* Keep the composition compact on short screens */
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero-portal {
      width: 390px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portal,
    .hero-portal-glow,
    .hero-star,
    .hero-scroll-arrow {
      animation: none;
    }
  }
</style>